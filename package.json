{
  "name": "web-bridger",
  "version": "0.1.1",
  "description": "Tiny, transport-agnostic pub/sub contract for messaging across iframes, Web Workers, or any custom postMessage-like channel.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run typecheck:test && npm test",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "postMessage",
    "iframe",
    "worker",
    "messagechannel",
    "transport",
    "pubsub"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=16"
  }
}
